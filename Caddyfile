{
	# Global options
	# local_certs: use Caddy's own CA (no Let's Encrypt); auto_https off is intentionally
	# omitted — tls internal in each site block handles cert issuance via the local CA.
	local_certs
}

https://localhost:8443 {
	tls internal

	# Preserve upstream-aware headers for OIDCProxy / FastMCP
	reverse_proxy mcp-server:8000 {
		header_up Host {http.request.host}
		header_up X-Real-IP {http.request.remote.host}
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.scheme}
		header_up X-Forwarded-Host {http.request.host}

		# Streaming support — FastMCP HTTP transport uses SSE-style responses.
		# Disable response buffering so chunks reach the client immediately.
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
