# .env.example
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ============================================================================
# Required Configuration
# ============================================================================

# Your Revenium API key (get from https://ai.revenium.io)
# Format: hak_xxxxxxxxxxxx (starts with hak_)
REVENIUM_API_KEY=hak_your_api_key_here


# ============================================================================
# Profile Selection
# ============================================================================

# Choose your tool profile:
# - "starter" (default): 7 tools for cost monitoring, alerts, AI metering
# - "business": 15 tools including product management, billing, subscriptions
TOOL_PROFILE=starter


# ============================================================================
# Optional - Auto-loaded from Your Account
# ============================================================================
# These values are automatically loaded from your Revenium account when you
# authenticate. Only override these if you need to work with different values.

# Team ID (organization identifier)
# REVENIUM_TEAM_ID=your_team_id

# Tenant ID (for multi-tenant environments)
# REVENIUM_TENANT_ID=your_tenant_id

# Owner ID (user identifier)
# REVENIUM_OWNER_ID=your_owner_id

# Default email for alert notifications
# REVENIUM_DEFAULT_EMAIL=your_email@example.com


# ============================================================================
# Optional - API Configuration
# ============================================================================

# Revenium API endpoint (defaults to production)
# REVENIUM_BASE_URL=https://api.revenium.ai

# Revenium application/analytics host used by tool-cost analytics
# (cost-by-tool, cost-by-user, and other /api/v2/analytics/* endpoints)
# and Slack integrations. If REVENIUM_BASE_URL points at a non-production
# environment, set this too — otherwise analytics calls default to
# https://app.revenium.ai (production) and return 401 for non-prod API keys.
# REVENIUM_APP_BASE_URL=https://ai.revenium.io

# API request timeout in seconds
# REQUEST_TIMEOUT=30

# Route analytics endpoints to the new ClickHouse-backed API instead of the
# legacy profitstream paths. Defaults to false.
# REVENIUM_USE_NEW_ANALYTICS_API=false


# ============================================================================
# Optional - Logging
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO


# ============================================================================
# Optional - AI Routing (Experimental Feature)
# ============================================================================
# AI routing is DISABLED by default. Only enable if you need natural language
# query interpretation. This will make OpenAI API calls and incur costs.

# Enable AI-powered query routing
# AI_ROUTING_ENABLED=false

# OpenAI API key (only needed if AI_ROUTING_ENABLED=true)
# Format: sk-xxxxxxxxxxxx (starts with sk-)
# OPENAI_API_KEY=sk-your_openai_key_here

# Model for AI routing (default: gpt-3.5-turbo)
# AI_MODEL_NAME=gpt-3.5-turbo


# ============================================================================
# Transport Mode
# ============================================================================
# stdio (default) — local MCP client via stdin/stdout (Claude Desktop, IDEs)
# http            — HTTP/SSE transport on MCP_HOST:MCP_PORT
#
# Valid combinations with AUTH_MODE:
#   env   + stdio  → local single-tenant (default)
#   env   + http   → HTTP without auth (dev/trusted networks only!)
#   clerk + http   → production multi-tenant
#   clerk + stdio  → REJECTED at startup (OAuth needs HTTP callbacks)
TRANSPORT_MODE=stdio

# HTTP bind host and port (only used when TRANSPORT_MODE=http).
# Default 127.0.0.1 (loopback) — set to 0.0.0.0 to bind all interfaces.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000


# ============================================================================
# Authentication Mode
# ============================================================================
# env (default) — single-tenant stdio, reads REVENIUM_API_KEY from env
# clerk          — multi-tenant HTTP+OAuth via Clerk
AUTH_MODE=env


# ============================================================================
# Clerk OAuth (only when AUTH_MODE=clerk)
# ============================================================================
# Domain of your Clerk instance (no https:// prefix).
# CLERK_DOMAIN=your-instance.clerk.accounts.dev

# OAuth Application credentials created in Clerk Dashboard.
# CLERK_OAUTH_CLIENT_ID=
# CLERK_OAUTH_CLIENT_SECRET=

# Public base URL where this MCP server is reachable (used in OAuth metadata).
# MCP_SERVER_BASE_URL=https://mcp.revenium.io
