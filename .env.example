# .env.example
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ============================================================================
# Required Configuration
# ============================================================================

# Your Revenium API key (get from https://ai.revenium.io)
# Format: hak_xxxxxxxxxxxx (starts with hak_)
REVENIUM_API_KEY=hak_your_api_key_here


# ============================================================================
# Profile Selection
# ============================================================================

# Choose your tool profile:
# - "starter" (default): 7 tools for cost monitoring, alerts, AI metering
# - "business": 15 tools including product management, billing, subscriptions
TOOL_PROFILE=starter


# ============================================================================
# Optional - Auto-loaded from Your Account
# ============================================================================
# These values are automatically loaded from your Revenium account when you
# authenticate. Only override these if you need to work with different values.

# Team ID (organization identifier)
# REVENIUM_TEAM_ID=your_team_id

# Tenant ID (for multi-tenant environments)
# REVENIUM_TENANT_ID=your_tenant_id

# Owner ID (user identifier)
# REVENIUM_OWNER_ID=your_owner_id

# Default email for alert notifications
# REVENIUM_DEFAULT_EMAIL=your_email@example.com


# ============================================================================
# Optional - API Configuration
# ============================================================================

# Revenium API endpoint (defaults to production)
# REVENIUM_BASE_URL=https://api.revenium.ai

# Revenium web application URL (for Slack integrations)
# REVENIUM_APP_BASE_URL=https://ai.revenium.io

# API request timeout in seconds
# REQUEST_TIMEOUT=30


# ============================================================================
# Optional - Logging
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO


# ============================================================================
# Optional - AI Routing (Experimental Feature)
# ============================================================================
# AI routing is DISABLED by default. Only enable if you need natural language
# query interpretation. This will make OpenAI API calls and incur costs.

# Enable AI-powered query routing
# AI_ROUTING_ENABLED=false

# OpenAI API key (only needed if AI_ROUTING_ENABLED=true)
# Format: sk-xxxxxxxxxxxx (starts with sk-)
# OPENAI_API_KEY=sk-your_openai_key_here

# Model for AI routing (default: gpt-3.5-turbo)
# AI_MODEL_NAME=gpt-3.5-turbo


