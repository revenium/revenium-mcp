# .env.example
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ============================================================================
# Required Configuration
# ============================================================================

# Your Revenium API key (get from https://ai.revenium.io)
# Format: hak_xxxxxxxxxxxx (starts with hak_)
REVENIUM_API_KEY=hak_your_api_key_here


# ============================================================================
# Profile Selection
# ============================================================================

# Choose your tool profile:
# - "starter" (default): 7 tools for cost monitoring, alerts, AI metering
# - "business": 18 tools including product management, billing, subscriptions, AI insights
TOOL_PROFILE=starter


# ============================================================================
# Optional - Auto-loaded from Your Account
# ============================================================================
# These values are automatically loaded from your Revenium account when you
# authenticate. Only override these if you need to work with different values.

# Team ID (organization identifier)
# REVENIUM_TEAM_ID=your_team_id

# Tenant ID (for multi-tenant environments)
# REVENIUM_TENANT_ID=your_tenant_id

# Owner ID (user identifier)
# REVENIUM_OWNER_ID=your_owner_id

# Default email for alert notifications
# REVENIUM_DEFAULT_EMAIL=your_email@example.com


# ============================================================================
# Optional - API Configuration
# ============================================================================

# Revenium API endpoint (defaults to production)
# REVENIUM_BASE_URL=https://api.revenium.ai

# Revenium application/analytics host used by tool-cost analytics
# (cost-by-tool, cost-by-user, and other /api/v2/analytics/* endpoints)
# and Slack integrations. If REVENIUM_BASE_URL points at a non-production
# environment, set this too — otherwise analytics calls default to
# https://app.revenium.ai (production) and return 401 for non-prod API keys.
# REVENIUM_APP_BASE_URL=https://ai.revenium.io

# API request timeout in seconds
# REQUEST_TIMEOUT=30

# Route analytics endpoints to the new ClickHouse-backed API instead of the
# legacy profitstream paths. Defaults to false.
# REVENIUM_USE_NEW_ANALYTICS_API=false


# ============================================================================
# Optional - Logging
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO


# ============================================================================
# Transport Mode
# ============================================================================
# stdio (default) — local MCP client via stdin/stdout (Claude Desktop, IDEs)
# http            — HTTP/SSE transport on MCP_HOST:MCP_PORT
#
# Valid combinations with AUTH_MODE:
#   env     + stdio → local single-tenant (default)
#   env     + http  → HTTP without auth (dev/trusted networks only!)
#   api_key + http  → public multi-tenant; per-request Revenium key as bearer
#   api_key + stdio → REJECTED at startup (bearer auth needs an HTTP endpoint)
TRANSPORT_MODE=stdio

# HTTP bind host and port (only used when TRANSPORT_MODE=http).
# Default 127.0.0.1 (loopback) — set to 0.0.0.0 to bind all interfaces.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000


# ============================================================================
# Authentication Mode
# ============================================================================
# env (default) — single-tenant stdio, reads REVENIUM_API_KEY from env
# api_key        — public multi-tenant; each caller sends their own Revenium
#                  key as an Authorization: Bearer token, validated per-request
#                  against {REVENIUM_BASE_URL}/profitstream/v2/api/users/me.
#                  Requires TRANSPORT_MODE=http and MCP_SERVER_BASE_URL; no
#                  server-wide REVENIUM_API_KEY is used by the auth gate.
AUTH_MODE=env


# ============================================================================
# API Key Mode (only when AUTH_MODE=api_key)
# ============================================================================
# Public hosting where each caller authenticates with their own Revenium key
# (rev_sk_ write or rev_rk_ read), sent as an Authorization: Bearer token and
# validated per request against the platform's /profitstream/v2/api/users/me.
# Metering-only keys (rev_mk_) are rejected.
#
# Required in this mode:
#   TRANSPORT_MODE=http
#   REVENIUM_BASE_URL    — platform host; also where keys are validated
#   MCP_SERVER_BASE_URL  — public URL where this server is reachable
#
# Public base URL where this MCP server is reachable.
# (For the local docker compose stack, use https://localhost:8443 — see below.)
# MCP_SERVER_BASE_URL=https://mcp.your-domain.com
#
# Optional:
# Per-key identity cache TTL in seconds (default 30).
# API_KEY_CACHE_TTL_SECONDS=30

# ============================================================================
# Docker Compose
# ============================================================================
# When using `docker compose up`, set these to the values your local stack uses.
# The Caddy reverse proxy listens on https://localhost:8443 by default.
#
# MCP_SERVER_BASE_URL must be HTTPS and point at the Caddy endpoint
# (NOT http://mcp-server:8000, which is only reachable inside the
# compose network).
#
# Recommended dev defaults:
#   AUTH_MODE=api_key
#   TRANSPORT_MODE=http
#   MCP_HOST=0.0.0.0
#   MCP_PORT=8000
#   MCP_SERVER_BASE_URL=https://localhost:8443
#
# NOTE: When using docker compose, MCP_PORT is locked to 8000 by an
# environment: override in compose.yaml — changing it in .env has no effect.
# The Caddyfile also hard-codes the upstream as `mcp-server:8000`; if you
# need a different port, both compose.yaml and Caddyfile must be edited.
#
# Copy this file to .env and fill in your values (AUTH_MODE, REVENIUM_BASE_URL,
# MCP_SERVER_BASE_URL — plus REVENIUM_API_KEY only when AUTH_MODE=env).
# Compose reads .env automatically — never commit it.
